# ==================================================
# Secrets / environment variables — NEVER commit
# ==================================================
.env
.env.*
!.env.example
!.env.template

# Database exports / backups — do not publish real data
*.sql.gz
*.dump
*.bak
db_backups/
backups/

# Keep checked-in SQL migrations
!backend/migrations/*.sql

# ==================================================
# Rust / Cargo / Tauri
# ==================================================
target/
**/target/
**/target copy/

# Tauri generated bundles and installers
src-tauri/target/
src-tauri/gen/

# Rust IDE files
*.rs.bk

# Keep Cargo.lock for applications (Tauri backend is an app)
# Do NOT add Cargo.lock here

# ==================================================
# React / Node.js / Vite
# ==================================================
node_modules/
**/node_modules/

# Next.js specific
.next/
.next/
.next-dev/
out/
build/
.cache/

# Next.js hot update files
.next/static/webpack/*.hot-update.*
.next/static/webpack/*.hot-update.js

# Accidental copied project trees / temp artifacts
**/src copy/
**/db copy/
**/migrations copy/
**/tests copy/
**/Cargo copy.toml
**/Cargo copy.lock
*.tmp
*.temp
*.orig

dist/
coverage/
.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Optional package-manager files that are normally local
.pnpm-store/

# Keep package-lock.json / yarn.lock / pnpm-lock.yaml committed
# They make installs reproducible.

# ==================================================
# Flutter / Dart
# ==================================================
.dart_tool/
.packages
.pub/
.pub-cache/
build/

# Flutter plugin generated files
.flutter-plugins
.flutter-plugins-dependencies

# Dart/Flutter IDE metadata
*.iml

# Android generated files
android/.gradle/
android/app/build/
android/local.properties
android/key.properties
android/.cxx/

# Android signing keys — NEVER commit
*.jks
*.keystore
*.p12

# iOS generated files
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Runner/GeneratedPluginRegistrant.*

# macOS generated files
macos/Flutter/ephemeral/
macos/Flutter/GeneratedPluginRegistrant.swift

# Windows/Linux generated plugin files
windows/flutter/ephemeral/
linux/flutter/ephemeral/

# ==================================================
# Editors / operating system
# ==================================================
.vscode/
.idea/
.zed/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
