# RoyalEntry Backend Configuration (.env.example)
# Copy this to .env and fill in your values

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://royalentry_user:dev_password_change_in_prod@localhost:5432/royalentry_db
DATABASE_MAX_CONNECTIONS=20
DATABASE_CONNECTION_TIMEOUT_SECS=30
DATABASE_IDLE_TIMEOUT_SECS=300
DATABASE_MAX_LIFETIME_SECS=1800

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
ENVIRONMENT=development
# production | staging | development

# ============================================================================
# JWT & AUTHENTICATION
# ============================================================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_use_32_chars_minimum
# Short access-token lifetime; the client auto-refreshes via the refresh token.
JWT_EXPIRY_HOURS=2
JWT_REFRESH_EXPIRY_DAYS=30

# ============================================================================
# M-PESA INTEGRATION (Daraja API)
# ============================================================================
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=123456
MPESA_PASSKEY=your_daraja_passkey
MPESA_INITIATOR_NAME=royalentry
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_ENVIRONMENT=sandbox
# sandbox | production

# ============================================================================
# SMS GATEWAY (Africa's Talking)
# ============================================================================
AT_API_KEY=your_africa_talking_api_key
AT_USERNAME=your_africa_talking_username
AT_FROM_NAME=RoyalEntry

# ============================================================================
# WHATSAPP BUSINESS API
# ============================================================================
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ============================================================================
# EMAIL CONFIGURATION (SMTP — Outlook)
# ============================================================================
# Outlook: smtp-mail.outlook.com:587 (STARTTLS). Use an app password, not the
# account password. The sender address must be the SMTP account itself.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=agbbelly89@outlook.com
SMTP_PASSWORD=your_outlook_app_password
SMTP_FROM_ADDRESS=agbbelly89@outlook.com
SMTP_FROM_NAME=RoyalEntry
# Alternative: Resend (requires a verified sending domain).
# RESEND_API_KEY=
# EMAIL_FROM=RoyalEntry <noreply@yourdomain.com>

# ============================================================================
# OUTBOUND MESSAGING CHANNELS (kept server-side only — never NEXT_PUBLIC_*)
# ============================================================================
# SMS — Beem (https://beem.africa). Sender name must be approved by Beem.
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_NAME=

# Email — Resend (https://resend.com). Verify your sending domain via DNS
# (merge Resend's SPF entry into the domain's existing SPF record).
RESEND_API_KEY=
EMAIL_FROM=RoyalEntry <noreply@royalentry.foctek.co.tz>

# Telegram — create a bot with @BotFather. Guests opt in by pressing
# t.me/<yourbot>?start=<invite-token>; the webhook saves their chat_id against
# the guest. Set the webhook once:
#   curl -X POST https://api.telegram.org/bot<TOKEN>/setWebhook \
#     -d url=https://royalentry.foctek.co.tz/api/v1/telegram/webhook
TELEGRAM_BOT_TOKEN=
# Bot username (without @) used to build the t.me/<bot>?start=... opt-in link.
TELEGRAM_BOT_USERNAME=
# Optional: when set, the webhook rejects calls without this secret token.
# Pass the same value to setWebhook as `secret_token`.
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (https://developers.facebook.com). Use a permanent token
# from a System User, not the temporary 24-hour token. Templates must be
# approved by Meta before first contact with a guest.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ============================================================================
# STORAGE (S3-Compatible — any provider: AWS, Wasabi, DO Spaces, MinIO, Linode, etc.)
# ==========================================================================
STORAGE_BUCKET=royalentry-uploads
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_ENDPOINT_URL=
# Leave empty for AWS; set for MinIO/Wasabi/DO Spaces (e.g., https://nyc3.digitaloceanspaces.com)

# ============================================================================
# LOGGING
# ============================================================================
RUST_LOG=royalentry=debug,sqlx=info,tower_http=debug,axum=debug
LOG_FORMAT=json
# json | pretty | compact

# ============================================================================
# SECURITY
# ============================================================================
QR_ENCRYPTION_KEY=your_aes_256_key_in_base64_64_chars_when_decoded
QR_SIGNING_KEY=your_ed25519_private_key_in_base64_32_bytes_when_decoded
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8100
# Production: comma-separated allowed browser origins, e.g.
# CORS_ALLOWED_ORIGINS=https://royalentry.foctek.co.tz
# Comma-separated list of allowed origins

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=RoyalEntry
APP_VERSION=0.1.0
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
MOBILE_APP_URL=http://localhost:8100

# ============================================================================
# FRONTEND (Next.js) — these live in frontend-next/.env.local, never in this
# backend .env. See frontend-next/.env.example.
# ============================================================================
# NEXT_PUBLIC_API_URL=https://royalentry.foctek.co.tz
# NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=2

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECS=60

# ============================================================================
# FILE UPLOAD
# ============================================================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_EXTENSIONS=pdf,docx,xlsx,csv

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_LIVE_TESTS=false
# Set to true to allow channel test endpoint (POST /admin/channels/{kind}/test)
ENABLE_PAYMENT_SANDBOX=true
ENABLE_SMS_SANDBOX=true
ENABLE_WHATSAPP_SANDBOX=true
ENABLE_TELEGRAM_SANDBOX=true

# ============================================================================
# STRIPE (Alternative Payment - Phase 2)
# ============================================================================
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# ============================================================================
# ADMIN CREDENTIALS (First User Setup)
# ============================================================================
ADMIN_EMAIL=admin@royalentry.co.tz
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=+255700000000
ADMIN_NAME=Super Admin
