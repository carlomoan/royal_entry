# RoyalEntry Backend Configuration (.env.example)
# Copy this to .env and fill in your values

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://royalentry_user:dev_password_change_in_prod@localhost:5432/royalentry_db
DATABASE_MAX_CONNECTIONS=20
DATABASE_CONNECTION_TIMEOUT_SECS=30
DATABASE_IDLE_TIMEOUT_SECS=300
DATABASE_MAX_LIFETIME_SECS=1800

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
ENVIRONMENT=development
# production | staging | development

# ============================================================================
# JWT & AUTHENTICATION
# ============================================================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_use_32_chars_minimum
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ============================================================================
# M-PESA INTEGRATION (Daraja API)
# ============================================================================
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=123456
MPESA_PASSKEY=your_daraja_passkey
MPESA_INITIATOR_NAME=royalentry
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_ENVIRONMENT=sandbox
# sandbox | production

# ============================================================================
# SMS GATEWAY (Africa's Talking)
# ============================================================================
AT_API_KEY=your_africa_talking_api_key
AT_USERNAME=your_africa_talking_username
AT_FROM_NAME=RoyalEntry

# ============================================================================
# WHATSAPP BUSINESS API
# ============================================================================
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_ADDRESS=noreply@royalentry.co.tz
SMTP_FROM_NAME=RoyalEntry
SMTP_USE_TLS=true

# ============================================================================
# CLOUD STORAGE (AWS S3 or similar)
# ============================================================================
AWS_S3_BUCKET=royalentry-uploads-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_ENDPOINT_URL=
# Leave empty for AWS, or set for LocalStack/MinIO testing

# ============================================================================
# LOGGING
# ============================================================================
RUST_LOG=royalentry=debug,sqlx=info,tower_http=debug,axum=debug
LOG_FORMAT=json
# json | pretty | compact

# ============================================================================
# SECURITY
# ============================================================================
QR_ENCRYPTION_KEY=your_aes_256_key_in_base64_64_chars_when_decoded
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8100
# Comma-separated list of allowed origins

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=RoyalEntry
APP_VERSION=0.1.0
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
MOBILE_APP_URL=http://localhost:8100

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECS=60

# ============================================================================
# FILE UPLOAD
# ============================================================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_EXTENSIONS=pdf,docx,xlsx,csv

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_DEMO_MODE=false
ENABLE_PAYMENT_SANDBOX=true
ENABLE_SMS_SANDBOX=true
ENABLE_WHATSAPP_SANDBOX=true

# ============================================================================
# STRIPE (Alternative Payment - Phase 2)
# ============================================================================
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# ============================================================================
# ADMIN CREDENTIALS (First User Setup)
# ============================================================================
ADMIN_EMAIL=admin@royalentry.co.tz
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=+255700000000
ADMIN_NAME=Super Admin
