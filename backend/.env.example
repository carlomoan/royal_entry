# ==============================================================================
# RoyalEntry backend — outbound channel configuration
# Copy the values you need into the real backend .env. Values here are the
# defaults used when a key is absent. The Settings UI can override any of
# these (same names, lowercase) and stores them in system_settings.
# Secrets are write-only: GET /settings/system returns ******** for them.
# ==============================================================================

# ── SMS: NextSMS and Unitxt (Beem is no longer supported) ─────────────────────
# SMS_PROVIDER=nextsms                 # nextsms | unitxt | empty = auto
# SMS_PROVIDER_ORDER=nextsms,unitxt    # preference order when both are set
# SMS_FAILOVER=true                    # try the next provider on failure
# NEXTSMS_API_TOKEN=
# NEXTSMS_SENDER_ID=
# NEXTSMS_BASE_URL=https://messaging-service.co.tz
# UNITXT_API_TOKEN=
# UNITXT_SENDER_ID=
# UNITXT_BASE_URL=https://unitxt.co.tz/api/v3

# ── Email: Resend or SMTP ─────────────────────────────────────────────────────
# EMAIL_PROVIDER=resend                # resend | smtp | empty = auto
# RESEND_API_KEY=
# EMAIL_FROM=RoyalEntry <noreply@your-verified-domain.com>
# EMAIL_FROM_NAME=RoyalEntry
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# ── Telegram ──────────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# ── WhatsApp: Meta Cloud API or NextSMS ──────────────────────────────────────
# WHATSAPP_PROVIDER=cloud                 # cloud | nextsms | empty = auto
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# NEXTSMS_WHATSAPP_ACCOUNT=               # NextSMS WhatsApp account name
# NEXTSMS_WHATSAPP_TEMPLATE=              # approved NextSMS template name
# NEXTSMS_WHATSAPP_PLACEHOLDERS=message    # placeholder names in the template body, without braces
# (NextSMS WhatsApp uses NEXTSMS_API_TOKEN and NEXTSMS_BASE_URL from above)

# ── Sandbox (local testing only; forced off when ENVIRONMENT=production) ──────
# ENABLE_SMS_SANDBOX=false
# ENABLE_WHATSAPP_SANDBOX=false

# ── Core ──────────────────────────────────────────────────────────────────────
# ENVIRONMENT=development
# DATABASE_URL=postgresql://user:pass@localhost:5432/royalentry_db
# JWT_SECRET=
# FRONTEND_URL=http://localhost:3001
