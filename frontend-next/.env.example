# ==============================================================================
# RoyalEntry frontend environment (copy to .env.local for local development)
# ==============================================================================

# Base URL of the RoyalEntry API. When unset the app calls the same-origin
# /api/v1 path, which the Next.js server rewrites to the backend at
# http://127.0.0.1:3000. Set this only when the API lives on a different host.
# NEXT_PUBLIC_API_URL=https://royalentry.foctek.co.tz

# Idle session timeout in minutes. After this period of inactivity the user is
# signed out and must sign in again. Default: 2
# NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=2

# NOTE: never put backend secrets (BEEM_*, RESEND_*, WHATSAPP_*, TELEGRAM_*,
# JWT_*, DATABASE_URL, ...) in this file or any NEXT_PUBLIC_* variable — they
# are baked into the browser bundle. They belong in backend/.env only.